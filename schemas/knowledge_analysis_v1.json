{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openutilitylab.com/schemas/knowledge_analysis_v1.json",
  "title": "KNOWLEDGE_ANALYSIS_V1",
  "description": "Semantic extraction of reusable technical knowledge from bounded static repository evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["capabilities", "patterns", "lessons", "opportunities", "limitations"],
  "properties": {
    "capabilities": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "minLength": 1, "maxLength": 220}
    },
    "patterns": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/pattern"}
    },
    "lessons": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/lesson"}
    },
    "opportunities": {
      "type": "array",
      "maxItems": 10,
      "items": {"$ref": "#/$defs/opportunity"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "minLength": 1, "maxLength": 260}
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^E[0-9]{2}$"}
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "transferability", "confidence", "evidence_refs"],
      "properties": {
        "id": {"type": "string", "pattern": "^P[0-9]{2}$"},
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "description": {"type": "string", "minLength": 1, "maxLength": 500},
        "transferability": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "lesson", "confidence", "evidence_refs"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 120},
        "lesson": {"type": "string", "minLength": 1, "maxLength": 500},
        "confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    },
    "opportunity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_project_id",
        "action",
        "title",
        "rationale",
        "expected_benefit",
        "integration_cost",
        "risk",
        "evidence_refs"
      ],
      "properties": {
        "target_project_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "action": {"enum": ["APPLY", "EXPERIMENT", "WATCH", "DISCARD"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 140},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "expected_benefit": {"type": "string", "minLength": 1, "maxLength": 300},
        "integration_cost": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      }
    }
  }
}
