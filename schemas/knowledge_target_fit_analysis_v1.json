{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openutilitylab.com/schemas/knowledge_target_fit_analysis_v1.json",
  "title": "KNOWLEDGE_TARGET_FIT_ANALYSIS_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {"$ref": "#/$defs/result"}
    }
  },
  "$defs": {
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opportunity_id",
        "classification",
        "applicable",
        "core_behavior_present",
        "fit_confidence",
        "rationale",
        "matched_needs",
        "target_evidence_refs",
        "integration_surface"
      ],
      "properties": {
        "opportunity_id": {"type": "string", "pattern": "^KOP-[0-9a-f]{16}$"},
        "classification": {
          "enum": [
            "ALREADY_PRESENT",
            "NOT_APPLICABLE",
            "EXPERIMENT_READY",
            "READY_TO_TRANSFER"
          ]
        },
        "applicable": {"type": "boolean"},
        "core_behavior_present": {"type": "boolean"},
        "fit_confidence": {"enum": ["HIGH", "MEDIUM", "LOW"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 500},
        "matched_needs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 120}
        },
        "target_evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^E[0-9]{2}$"}
        },
        "integration_surface": {
          "type": ["string", "null"],
          "maxLength": 220
        }
      }
    }
  }
}
