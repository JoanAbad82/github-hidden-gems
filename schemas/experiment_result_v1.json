{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openutilitylab.com/schemas/experiment_result_v1.json",
  "title": "EXPERIMENT_RESULT_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "queue_id",
    "experiment_id",
    "opportunity_id",
    "state",
    "target_repository",
    "target_base_sha",
    "experiment_head_sha",
    "falsifier_triggered",
    "observations",
    "checks",
    "conclusion",
    "evidence_files",
    "no_auto_merge"
  ],
  "properties": {
    "schema_version": {"const": "EXPERIMENT_RESULT_V1"},
    "queue_id": {"type": "string", "pattern": "^EXQ-[0-9a-f]{16}$"},
    "experiment_id": {"type": "string", "pattern": "^EXP-[0-9a-f]{16}$"},
    "opportunity_id": {"type": "string", "pattern": "^KOP-[0-9a-f]{16}$"},
    "state": {"enum": ["PASSED", "FAILED", "REJECTED"]},
    "target_repository": {"type": "string", "minLength": 3},
    "target_base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "experiment_head_sha": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        {"type": "null"}
      ]
    },
    "falsifier_triggered": {"type": "boolean"},
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exit_code", "result"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "exit_code": {"type": "integer", "minimum": 0},
          "result": {"enum": ["PASS", "FAIL"]}
        }
      }
    },
    "conclusion": {"type": "string", "minLength": 1},
    "evidence_files": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "no_auto_merge": {"const": true}
  }
}
