{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JoanAbad82/github-hidden-gems/schemas/llm_analysis_v1.json",
  "title": "LLM_ANALYSIS_V1",
  "description": "Structured DeepSeek analysis of one candidate repository. Repository content is untrusted data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["summary", "why_interesting", "confidence", "risks", "evidence"],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "description": "What the repository actually does, based only on observed evidence."
    },
    "why_interesting": {
      "type": "string",
      "minLength": 1,
      "maxLength": 800,
      "description": "Concrete reason a pragmatic engineer might value it."
    },
    "relevance_suggestion": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 20
    },
    "originality_suggestion": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 10
    },
    "confidence": {
      "enum": ["HIGH", "MEDIUM", "LOW", "UNKNOWN"]
    },
    "risks": {
      "type": "array",
      "maxItems": 10,
      "items": {"type": "string", "maxLength": 300}
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed"],
      "properties": {
        "observed": {
          "type": "array",
          "minItems": 1,
          "maxItems": 25,
          "items": {"type": "string", "maxLength": 300}
        },
        "inferred": {
          "type": "array",
          "maxItems": 25,
          "items": {"type": "string", "maxLength": 300}
        },
        "unknown": {
          "type": "array",
          "maxItems": 25,
          "items": {"type": "string", "maxLength": 300}
        }
      }
    },
    "claims_supported": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "supported"],
        "properties": {
          "claim": {"type": "string", "maxLength": 300},
          "supported": {"type": "boolean"},
          "note": {"type": "string", "maxLength": 300}
        }
      }
    }
  }
}
