{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openutilitylab.com/schemas/knowledge_packet_v1.json",
  "title": "KNOWLEDGE_PACKET_V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prompt_version",
    "model",
    "source",
    "reuse_policy",
    "capabilities",
    "patterns",
    "lessons",
    "opportunities",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "KNOWLEDGE_PACKET_V1"},
    "prompt_version": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "source": {"$ref": "#/$defs/source"},
    "reuse_policy": {"enum": ["ADAPT_CONCEPT"]},
    "capabilities": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 220}
    },
    "patterns": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "knowledge_analysis_v1.json#/$defs/pattern"}
    },
    "lessons": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "knowledge_analysis_v1.json#/$defs/lesson"}
    },
    "opportunities": {
      "type": "array",
      "maxItems": 6,
      "items": {"$ref": "knowledge_analysis_v1.json#/$defs/opportunity"}
    },
    "limitations": {
      "type": "array",
      "maxItems": 6,
      "items": {"type": "string", "minLength": 1, "maxLength": 260}
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "github_repo_id",
        "full_name",
        "html_url",
        "head_sha",
        "default_branch",
        "license_spdx_id",
        "evidence_digest",
        "evidence_manifest"
      ],
      "properties": {
        "github_repo_id": {"type": "integer", "minimum": 1},
        "full_name": {"type": "string", "minLength": 3},
        "html_url": {"type": "string", "pattern": "^https://github\\.com/"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "default_branch": {"type": "string", "minLength": 1},
        "license_spdx_id": {"type": ["string", "null"]},
        "evidence_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_manifest": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "items": {"$ref": "#/$defs/evidenceItem"}
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "blob_sha", "category", "size", "content_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^E[0-9]{2}$"},
        "path": {"type": "string", "minLength": 1, "maxLength": 300},
        "blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "category": {"enum": ["readme", "architecture", "safety", "state", "routing", "source", "test", "config", "docs"]},
        "size": {"type": "integer", "minimum": 1},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
